# Base URL of the QueueForge backend (used for REST and Socket.IO)
VITE_API_URL=http://localhost:4000
=======
# Runtime
NODE_ENV=development
PORT=4000

# MongoDB. In Docker, use the MongoDB service hostname (for example: mongo).
MONGODB_URI=mongodb://mongo:27017/queueforge

# Redis/BullMQ. Prefer REDIS_URL in hosted environments; otherwise use host/port.
REDIS_URL=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# JWT signing secret: use a random value of at least 32 characters.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=1h

# Password hashing
BCRYPT_ROUNDS=12

# Comma-separated browser origins allowed by the API and Socket.IO.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Queue defaults (per-job values can override these).
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_DEFAULT_BACKOFF_MS=1000
QUEUE_REMOVE_ON_COMPLETE=500

# Worker process
WORKER_ID=
WORKER_CONCURRENCY=5
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_STALE_AFTER_MS=30000

# API protection
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
