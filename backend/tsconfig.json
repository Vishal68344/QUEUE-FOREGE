{
    "compilerOptions":  {
                            "target":  "ES2022",
                            "module":  "CommonJS",
                            "moduleResolution":  "Node",
                            "lib":  [
                                        "ES2022"
                                    ],
                            "rootDir":  ".",
                            "strict":  true,
                            "noImplicitOverride":  true,
                            "noFallthroughCasesInSwitch":  true,
                            "noUncheckedIndexedAccess":  true,
                            "esModuleInterop":  true,
                            "forceConsistentCasingInFileNames":  true,
                            "skipLibCheck":  true,
                            "resolveJsonModule":  true,
                            "types":  [
                                          "node"
                                      ],
                            "outDir":  "dist"
                        },
    "include":  [
                    "src/**/*.ts",
                    "tests/**/*.ts",
                    "vitest.config.ts"
                ],
    "exclude":  [
                    "node_modules",
                    "dist",
                    "src/lib/api.ts",
                    "src/lib/socket.ts",
                    "src/lib/useApi.ts"
                ]
}
